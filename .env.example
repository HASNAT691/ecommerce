# ============================================================
# Al-Rehan Garments -- Environment Variables Template
# ============================================================
# Copy this file to .env and fill in all values before running.
# NEVER commit the .env file to source control.
# ============================================================

# Application
NODE_ENV=development
PORT=5000

# Database
MONGODB_CONNECTION_STRING=mongodb://127.0.0.1:27017/al-rehan-garments

# Session (generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
SESSION_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS

# Cloudinary (optional - falls back to local disk storage if not set)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Admin Registration Secret
ADMIN_REGISTRATION_SECRET=CHANGE_ME_ADMIN_REGISTRATION_SECRET