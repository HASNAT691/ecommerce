<style>
  /* Landing Page Custom Styling */
  .hero-carousel .carousel-item {
    height: 75vh;
    min-height: 480px;
    background-color: #111;
  }

  .hero-carousel .carousel-item img {
    height: 100%;
    width: 100%;
    object-fit: cover;
    opacity: 0.88;
  }

  .hero-glass-card {
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 1rem;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
  }

  .hero-dark-card {
    background: rgba(17, 17, 17, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 1rem;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
  }

  .feature-pillar-card {
    background-color: #fff;
    border: 1px solid #eef0f2;
    border-radius: 12px;
    padding: 1.5rem 1rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .feature-pillar-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
  }

  .category-banner-card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    height: 380px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
  }

  .category-banner-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .category-banner-card:hover img {
    transform: scale(1.08);
  }

  .category-banner-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0.1) 60%, transparent 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2rem;
    color: #fff;
  }

  .product-hover-card {
    border: none;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    background-color: #fff;
  }

  .product-hover-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
  }

  .product-img-wrapper {
    position: relative;
    height: 320px;
    overflow: hidden;
    background-color: #f8f9fa;
  }

  .product-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .product-hover-card:hover .product-img-wrapper img {
    transform: scale(1.05);
  }

  .brand-story-section {
    background: linear-gradient(135deg, #111827 0%, #1f2937 100%);
    color: #fff;
    border-radius: 20px;
    padding: 4rem 2rem;
  }

  @media (max-width: 768px) {
    .hero-carousel .carousel-item {
      height: 55vh;
      min-height: 360px;
    }
    .category-banner-card {
      height: 280px;
    }
    .product-img-wrapper {
      height: 240px;
    }
  }
</style>

<main class="bg-light">
  <!-- Announcement Bar -->
  <div class="bg-dark text-white text-center py-2 px-3 small font-monospace tracking-wide">
    <i class="fas fa-gem text-warning me-2"></i>AL REHAN SHOPPING CENTER — 100% Original Lawn & Designer Fabrics | Free Nationwide Delivery Over PKR 3,000
  </div>

  <!-- Interactive Hero Carousel -->
  <div id="landingHeroCarousel" class="carousel slide hero-carousel carousel-fade" data-bs-ride="carousel" data-bs-interval="5000">
    <div class="carousel-indicators">
      <button type="button" data-bs-target="#landingHeroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
      <button type="button" data-bs-target="#landingHeroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
      <button type="button" data-bs-target="#landingHeroCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
    </div>

    <div class="carousel-inner">
      <!-- Slide 1: Summer Lawn -->
      <div class="carousel-item active">
        <img src="/images/al_rehan_summer_banner.png" alt="Summer Lawn Collection 2026">
        <div class="carousel-caption h-100 d-flex align-items-center justify-content-start text-start p-3 p-md-5">
          <div class="hero-glass-card p-4 p-md-5 text-dark" style="max-width: 520px;">
            <span class="badge bg-dark text-uppercase tracking-wider mb-2 px-3 py-2">New Arrival '26</span>
            <h1 class="display-5 fw-bold mb-3">Summer Lawn Collection</h1>
            <p class="text-secondary fs-6 mb-4">Exquisite unstitched fabrics featuring delicate embroidery, vibrant colors, and premium textures designed for your daily and festive wear.</p>
            <a href="/secondpage?category=Summer Collection" class="btn btn-dark btn-lg px-4 py-2 fs-6 rounded-0">Explore Lawn</a>
          </div>
        </div>
      </div>

      <!-- Slide 2: Luxury Stitched -->
      <div class="carousel-item">
        <img src="/images/al_rehan_stitched_banner.png" alt="Luxury Stitched Ready-to-Wear">
        <div class="carousel-caption h-100 d-flex align-items-center justify-content-end text-start p-3 p-md-5">
          <div class="hero-glass-card p-4 p-md-5 text-dark" style="max-width: 520px;">
            <span class="badge bg-dark text-uppercase tracking-wider mb-2 px-3 py-2">Ready To Wear</span>
            <h1 class="display-5 fw-bold mb-3">Stitched Luxury</h1>
            <p class="text-secondary fs-6 mb-4">Meticulously tailored cuts, modern silhouettes, and premium styling. Elevate your wardrobe with comfort and sophistication.</p>
            <a href="/secondpage?category=Stitched" class="btn btn-dark btn-lg px-4 py-2 fs-6 rounded-0">Shop Stitched</a>
          </div>
        </div>
      </div>

      <!-- Slide 3: Fine Unstitched Fabrics -->
      <div class="carousel-item">
        <img src="/images/al_rehan_unstitched_banner.png" alt="Unstitched Fabrics & Linens">
        <div class="carousel-caption h-100 d-flex align-items-center justify-content-center text-center p-3 p-md-5">
          <div class="hero-dark-card p-4 p-md-5 text-white" style="max-width: 550px;">
            <span class="badge bg-light text-dark text-uppercase tracking-wider mb-2 px-3 py-2">Exquisite Prints</span>
            <h1 class="display-5 fw-bold mb-3">Unstitched Prints</h1>
            <p class="text-white-50 fs-6 mb-4">Fine cotton lawn, premium linens, and khaddar pieces complete with matching borders and embroidered patches.</p>
            <a href="/secondpage?category=Unstitched" class="btn btn-light btn-lg px-4 py-2 fs-6 rounded-0 text-dark">View Fabrics</a>
          </div>
        </div>
      </div>
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#landingHeroCarousel" data-bs-slide="prev">
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#landingHeroCarousel" data-bs-slide="next">
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Next</span>
    </button>
  </div>

  <!-- Brand Value Pillars -->
  <section class="py-5 bg-white border-bottom">
    <div class="container">
      <div class="row g-4 text-center">
        <div class="col-6 col-md-3">
          <div class="feature-pillar-card h-100">
            <i class="fas fa-tshirt fs-2 text-dark mb-3"></i>
            <h6 class="fw-bold mb-1">100% Original Fabrics</h6>
            <p class="small text-muted mb-0">Premium cotton lawn, linen & luxury silk</p>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="feature-pillar-card h-100">
            <i class="fas fa-truck-fast fs-2 text-dark mb-3"></i>
            <h6 class="fw-bold mb-1">Express Nationwide Shipping</h6>
            <p class="small text-muted mb-0">Fast dispatch across Pakistan</p>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="feature-pillar-card h-100">
            <i class="fas fa-money-bill-wave fs-2 text-dark mb-3"></i>
            <h6 class="fw-bold mb-1">COD & EasyPaisa</h6>
            <p class="small text-muted mb-0">Safe & convenient payment methods</p>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="feature-pillar-card h-100">
            <i class="fab fa-whatsapp fs-2 text-success mb-3"></i>
            <h6 class="fw-bold mb-1">WhatsApp Ordering</h6>
            <p class="small text-muted mb-0">Instant assistance & order support</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Collections Showcase Grid -->
  <section class="py-5">
    <div class="container">
      <div class="text-center mb-5">
        <span class="text-uppercase tracking-widest text-muted small fw-bold">Explore Our Collections</span>
        <h2 class="display-6 fw-bold mt-1">Shop By Category</h2>
        <div class="mx-auto bg-dark mt-2" style="height: 3px; width: 60px;"></div>
      </div>

      <div class="row g-4">
        <!-- Stitched -->
        <div class="col-md-6 col-lg-3">
          <div class="category-banner-card">
            <img src="/images/al_rehan_stitched_banner.png" alt="Stitched Collection">
            <div class="category-banner-overlay">
              <span class="badge bg-white text-dark align-self-start mb-2 px-3 py-1">Ready To Wear</span>
              <h4 class="fw-bold mb-1">Stitched Luxury</h4>
              <p class="small text-white-50 mb-3">2 & 3 Piece Suits, Kurtis</p>
              <a href="/secondpage?category=Stitched" class="btn btn-outline-light btn-sm align-self-start rounded-0 px-3">Shop Now →</a>
            </div>
          </div>
        </div>

        <!-- Unstitched -->
        <div class="col-md-6 col-lg-3">
          <div class="category-banner-card">
            <img src="/images/al_rehan_unstitched_banner.png" alt="Unstitched Lawn">
            <div class="category-banner-overlay">
              <span class="badge bg-white text-dark align-self-start mb-2 px-3 py-1">Fabrics</span>
              <h4 class="fw-bold mb-1">Unstitched Lawn</h4>
              <p class="small text-white-50 mb-3">Embroidered & Printed Lawn</p>
              <a href="/secondpage?category=Unstitched" class="btn btn-outline-light btn-sm align-self-start rounded-0 px-3">Shop Now →</a>
            </div>
          </div>
        </div>

        <!-- Summer Collection -->
        <div class="col-md-6 col-lg-3">
          <div class="category-banner-card">
            <img src="/images/al_rehan_summer_banner.png" alt="Summer Collection">
            <div class="category-banner-overlay">
              <span class="badge bg-white text-dark align-self-start mb-2 px-3 py-1">Summer '26</span>
              <h4 class="fw-bold mb-1">Summer Lawn</h4>
              <p class="small text-white-50 mb-3">Lightweight & Vibrant Colors</p>
              <a href="/secondpage?category=Summer Collection" class="btn btn-outline-light btn-sm align-self-start rounded-0 px-3">Shop Now →</a>
            </div>
          </div>
        </div>

        <!-- Kids Collection -->
        <div class="col-md-6 col-lg-3">
          <div class="category-banner-card">
            <img src="/images/al_rehan_stitched_banner.png" alt="Kids Collection">
            <div class="category-banner-overlay">
              <span class="badge bg-white text-dark align-self-start mb-2 px-3 py-1">Junior</span>
              <h4 class="fw-bold mb-1">Kids Wear</h4>
              <p class="small text-white-50 mb-3">Cute & Festive Outfits</p>
              <a href="/secondpage?category=Kids" class="btn btn-outline-light btn-sm align-self-start rounded-0 px-3">Shop Now →</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Products Section -->
  <% if (locals.featuredProducts && featuredProducts.length > 0) { %>
    <section class="py-5 bg-white border-top border-bottom">
      <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4">
          <div>
            <span class="text-uppercase tracking-widest text-muted small fw-bold">Handpicked Selection</span>
            <h2 class="display-6 fw-bold mt-1 mb-0">New Arrivals</h2>
          </div>
          <a href="/secondpage" class="btn btn-outline-dark rounded-0 px-4">View All Products →</a>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
          <% featuredProducts.forEach(product => { %>
            <div class="col">
              <div class="card product-hover-card h-100">
                <div class="product-img-wrapper">
                  <% if (product.images && product.images.length > 0) { %>
                    <img src="<%= product.images[0].startsWith('http') ? product.images[0] : '/uploads/' + product.images[0] %>" alt="<%= product.name %>">
                  <% } else { %>
                    <img src="/images/placeholder.jpg" alt="No image">
                  <% } %>
                  <span class="badge bg-dark position-absolute top-0 start-0 m-3 px-2 py-1">New</span>
                </div>
                <div class="card-body d-flex flex-column justify-content-between p-3">
                  <div>
                    <h6 class="card-title fw-bold text-dark text-truncate mb-1"><%= product.name %></h6>
                    <p class="small text-muted mb-2"><%= product.subcategories || 'Fashion' %></p>
                  </div>
                  <div class="d-flex justify-content-between align-items-center mt-2">
                    <span class="fw-bold fs-5 text-dark">PKR <%= (product.price || 0).toLocaleString() %></span>
                    <a href="/product/<%= product._id %>" class="btn btn-sm btn-dark rounded-0">View Details</a>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </section>
  <% } %>

  <!-- Brand Story & DG Khan Showroom Showcase -->
  <section class="py-5">
    <div class="container">
      <div class="brand-story-section text-center position-relative shadow-lg">
        <span class="text-uppercase tracking-widest text-warning small fw-bold">Heritage & Authenticity</span>
        <h2 class="display-5 fw-bold mt-2 mb-3">AL REHAN SHOPPING CENTER</h2>
        <p class="lead text-white-50 mx-auto mb-4" style="max-width: 750px;">
          Welcome to Al Rehan Shopping Center — your premier fashion destination for 100% authentic unstitched lawn, luxury stitched suits, and kids festive collections. Visit our flagship showroom in DG Khan or order online with complete confidence.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
          <a href="/secondpage" class="btn btn-warning btn-lg px-4 py-2 text-dark font-monospace rounded-0 fw-bold">Browse Catalog</a>
          <a href="https://wa.me/923457139939?text=Hi%2C%20I%20want%20to%20inquire%20about%20your%20latest%20collection" target="_blank" class="btn btn-outline-light btn-lg px-4 py-2 rounded-0">
            <i class="fab fa-whatsapp me-2"></i>Order on WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</main>