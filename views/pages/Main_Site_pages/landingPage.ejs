<style>
  /* ═══════════════════════════════════════════════
     AL REHAN SHOPPING CENTER - LUXURY LANDING PAGE
  ═══════════════════════════════════════════════ */

  /* Luxury Top Announcement Bar (Monochrome Luxury) */
  .luxury-announcement-bar {
    background: #000000;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    padding: 0.55rem 1rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }

  .luxury-announcement-bar .brand-badge {
    background: #ffffff;
    color: #000000;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    padding: 0.22rem 0.65rem;
    border-radius: 0;
    text-transform: uppercase;
  }

  .luxury-announcement-bar .brand-title {
    color: #ffffff;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .luxury-announcement-bar .text-divider {
    color: rgba(255, 255, 255, 0.35);
    font-size: 0.75rem;
    margin: 0 0.4rem;
  }

  .luxury-announcement-bar .fabrics-subtext {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.82rem;
    letter-spacing: 0.5px;
    font-weight: 400;
  }

  .luxury-announcement-bar .delivery-highlight-bw {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.25);
    padding: 0.22rem 0.85rem;
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.4px;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    transition: all 0.3s ease;
  }

  .luxury-announcement-bar .delivery-highlight-bw:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: #ffffff;
    transform: translateY(-1px);
  }

  @media (max-width: 576px) {
    .luxury-announcement-bar {
      padding: 0.45rem 0.75rem;
    }
    .luxury-announcement-bar .brand-title {
      font-size: 0.78rem;
      letter-spacing: 1.2px;
    }
    .luxury-announcement-bar .delivery-highlight-bw {
      font-size: 0.75rem;
      padding: 0.2rem 0.6rem;
    }
  }

  /* Hero Banner Carousel: Full Widescreen Display (No Cropping) */
  .hero-carousel {
    background-color: #f8f9fa;
    position: relative;
  }

  .hero-carousel .carousel-item {
    width: 100%;
    background-color: #f8f9fa;
  }

  .hero-carousel .carousel-item a {
    display: block;
    width: 100%;
    text-decoration: none;
  }

  .hero-carousel .carousel-item img {
    width: 100%;
    height: auto;
    aspect-ratio: 1920 / 788;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .hero-carousel .carousel-indicators button {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    margin: 0 6px;
    background-color: #111;
    border: 2px solid #fff;
    opacity: 0.6;
    transition: all 0.3s ease;
  }

  .hero-carousel .carousel-indicators button.active {
    opacity: 1;
    transform: scale(1.25);
    background-color: #000;
  }

  .hero-carousel .carousel-control-prev,
  .hero-carousel .carousel-control-next {
    width: 5%;
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .hero-carousel .carousel-control-prev:hover,
  .hero-carousel .carousel-control-next:hover {
    opacity: 1;
  }

  .hero-carousel .carousel-control-prev-icon,
  .hero-carousel .carousel-control-next-icon {
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 50%;
    background-size: 55%;
    padding: 22px;
  }

  /* Value Pillars */
  .feature-pillar-card {
    background-color: #fff;
    border: 1px solid #eef0f2;
    border-radius: 12px;
    padding: 1.75rem 1rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .feature-pillar-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
  }

  /* Curated Category Cards */
  .category-card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    height: 420px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
    background-color: #fff;
  }

  .category-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.15);
  }

  .category-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .category-card:hover img {
    transform: scale(1.06);
  }

  .category-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0.25) 50%, transparent 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2rem;
    color: #fff;
  }

  /* Product Cards */
  .product-hover-card {
    border: none;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    background-color: #fff;
  }

  .product-hover-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
  }

  .product-img-wrapper {
    position: relative;
    height: 320px;
    overflow: hidden;
    background-color: #f8f9fa;
  }

  .product-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .product-hover-card:hover .product-img-wrapper img {
    transform: scale(1.05);
  }

  /* Flagship Showroom Banner (Luxury Dark Aesthetic) */
  .showroom-banner {
    background: linear-gradient(135deg, #090d16 0%, #151b28 50%, #090d16 100%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #fff;
    border-radius: 16px;
    padding: 4.5rem 2rem;
    position: relative;
    overflow: hidden;
  }

  .showroom-banner::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 15%, rgba(255, 255, 255, 0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .showroom-btn-primary {
    background-color: #ffffff !important;
    color: #000000 !important;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-size: 0.85rem;
    padding: 0.9rem 2.4rem;
    border: 1px solid #ffffff;
    border-radius: 0;
    transition: all 0.3s ease;
    box-shadow: 0 4px 16px rgba(255, 255, 255, 0.15);
    text-decoration: none;
    display: inline-block;
  }

  .showroom-btn-primary:hover {
    background-color: transparent !important;
    color: #ffffff !important;
    border-color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(255, 255, 255, 0.25);
  }

  .showroom-btn-secondary {
    background-color: transparent !important;
    color: #ffffff !important;
    font-weight: 600;
    letter-spacing: 1px;
    font-size: 0.85rem;
    padding: 0.9rem 2.2rem;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 0;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-block;
  }

  .showroom-btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.15) !important;
    border-color: #ffffff;
    color: #ffffff !important;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .category-card {
      height: 300px;
    }
    .product-img-wrapper {
      height: 230px;
    }
    .hero-carousel .carousel-control-prev,
    .hero-carousel .carousel-control-next {
      display: none;
    }
  }
</style>

<main class="bg-light">
  <!-- Top Luxury Announcement Bar (Monochrome Luxury) -->
  <div class="luxury-announcement-bar">
    <div class="container d-flex flex-wrap align-items-center justify-content-center gap-2 text-center">
      <span class="brand-badge"><i class="fas fa-crown me-1"></i> Original</span>
      <span class="brand-title">AL REHAN SHOPPING CENTER</span>
      <span class="text-divider d-none d-md-inline">•</span>
      <span class="fabrics-subtext d-none d-sm-inline">100% Original Lawn &amp; Designer Fabrics</span>
      <span class="text-divider d-none d-md-inline">•</span>
      <div class="delivery-highlight-bw">
        <i class="fas fa-truck-fast text-white"></i>
        <span>Free Nationwide Delivery Above <strong class="text-white text-decoration-underline" style="text-underline-offset: 3px;">PKR 5,000</strong></span>
      </div>
    </div>
  </div>

  <!-- Full-Picture Widescreen Hero Carousel -->
  <div id="landingHeroCarousel" class="carousel slide hero-carousel carousel-fade shadow-sm" data-bs-ride="carousel" data-bs-interval="4500">
    <div class="carousel-indicators">
      <button type="button" data-bs-target="#landingHeroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
      <button type="button" data-bs-target="#landingHeroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
      <button type="button" data-bs-target="#landingHeroCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
      <button type="button" data-bs-target="#landingHeroCarousel" data-bs-slide-to="3" aria-label="Slide 4"></button>
    </div>

    <div class="carousel-inner">
      <!-- Slide 1: Luxury Lawn Summer -->
      <div class="carousel-item active">
        <a href="/secondpage?category=Summer Collection">
          <img src="/images/banner_luxury_lawn.png" alt="Luxury Lawn Summer Collection - Al Rehan Shopping Center">
        </a>
      </div>

      <!-- Slide 2: Signature Stitched Collection -->
      <div class="carousel-item">
        <a href="/secondpage?category=Stitched">
          <img src="/images/banner_signature_wear.png" alt="Signature Stitched Luxury Collection - Al Rehan Shopping Center">
        </a>
      </div>

      <!-- Slide 3: Unstitched Embroidered Collection -->
      <div class="carousel-item">
        <a href="/secondpage?category=Unstitched">
          <img src="/images/banner_unstitched.png" alt="Unstitched Collection 2-Piece 3-Piece Embroidered - Al Rehan Shopping Center">
        </a>
      </div>

      <!-- Slide 4: Slay Daily Festive Linen -->
      <div class="carousel-item">
        <a href="/secondpage?category=Ready-to-Wear">
          <img src="/images/banner_festive_linen.png" alt="Slay Daily Festive Linen - Al Rehan Shopping Center">
        </a>
      </div>
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#landingHeroCarousel" data-bs-slide="prev">
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#landingHeroCarousel" data-bs-slide="next">
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Next</span>
    </button>
  </div>

  <!-- Brand Value Pillars -->
  <section class="py-5 bg-white border-bottom">
    <div class="container">
      <div class="row g-4 text-center">
        <div class="col-6 col-md-3">
          <div class="feature-pillar-card h-100">
            <i class="fas fa-tshirt fs-2 text-dark mb-3"></i>
            <h6 class="fw-bold mb-1">100% Original Fabrics</h6>
            <p class="small text-muted mb-0">Premium cotton lawn, linen & luxury silk</p>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="feature-pillar-card h-100">
            <i class="fas fa-truck-fast fs-2 text-dark mb-3"></i>
            <h6 class="fw-bold mb-1">Express Nationwide Delivery</h6>
            <p class="small text-muted mb-0">Flat PKR 190 | Free over PKR 5,000</p>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="feature-pillar-card h-100">
            <i class="fas fa-money-bill-wave fs-2 text-dark mb-3"></i>
            <h6 class="fw-bold mb-1">COD & EasyPaisa</h6>
            <p class="small text-muted mb-0">Safe & convenient payment methods</p>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="feature-pillar-card h-100">
            <i class="fab fa-whatsapp fs-2 text-success mb-3"></i>
            <h6 class="fw-bold mb-1">WhatsApp Helpline</h6>
            <p class="small text-muted mb-0">Instant styling & order support</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Curated Category Showcase Grid -->
  <section class="py-5">
    <div class="container">
      <div class="text-center mb-5">
        <span class="text-uppercase tracking-widest text-muted small fw-bold">Handcrafted For You</span>
        <h2 class="display-6 fw-bold mt-1">Shop By Category</h2>
        <div class="mx-auto bg-dark mt-2" style="height: 3px; width: 60px;"></div>
      </div>

      <div class="row g-4">
        <!-- Stitched Luxury (Full model in pastel gown) -->
        <div class="col-md-6 col-lg-3">
          <div class="category-card">
            <img src="/images/al_rehan_stitched_banner.png" alt="Stitched Luxury Suits">
            <div class="category-card-overlay">
              <span class="badge bg-white text-dark align-self-start mb-2 px-3 py-1">Ready To Wear</span>
              <h4 class="fw-bold mb-1">Stitched Luxury</h4>
              <p class="small text-white-50 mb-3">2 & 3 Piece Suits, Kurtis</p>
              <a href="/secondpage?category=Stitched" class="btn btn-outline-light btn-sm align-self-start rounded-0 px-3">Shop Stitched →</a>
            </div>
          </div>
        </div>

        <!-- Unstitched Lawn (Pastel embroidered fabrics) -->
        <div class="col-md-6 col-lg-3">
          <div class="category-card">
            <img src="/images/al_rehan_unstitched_banner.png" alt="Unstitched Lawn Fabrics">
            <div class="category-card-overlay">
              <span class="badge bg-white text-dark align-self-start mb-2 px-3 py-1">Fabrics</span>
              <h4 class="fw-bold mb-1">Unstitched Lawn</h4>
              <p class="small text-white-50 mb-3">Embroidered & Printed Lawn</p>
              <a href="/secondpage?category=Unstitched" class="btn btn-outline-light btn-sm align-self-start rounded-0 px-3">Shop Fabrics →</a>
            </div>
          </div>
        </div>

        <!-- Summer Lawn (Artisan flat lay with scissors & spools) -->
        <div class="col-md-6 col-lg-3">
          <div class="category-card">
            <img src="/images/al_rehan_summer_banner.png" alt="Summer Lawn Collection">
            <div class="category-card-overlay">
              <span class="badge bg-white text-dark align-self-start mb-2 px-3 py-1">Summer '26</span>
              <h4 class="fw-bold mb-1">Summer Lawn</h4>
              <p class="small text-white-50 mb-3">Lightweight & Vibrant Colors</p>
              <a href="/secondpage?category=Summer Collection" class="btn btn-outline-light btn-sm align-self-start rounded-0 px-3">Explore Lawn →</a>
            </div>
          </div>
        </div>

        <!-- Kids Collection -->
        <div class="col-md-6 col-lg-3">
          <div class="category-card">
            <img src="/images/RTW-September-2024-Kids_MAIN-WEB-BANNER-1920-X-750-1.webp" alt="Kids Festive Wear">
            <div class="category-card-overlay">
              <span class="badge bg-white text-dark align-self-start mb-2 px-3 py-1">Junior</span>
              <h4 class="fw-bold mb-1">Kids Wear</h4>
              <p class="small text-white-50 mb-3">Charming Festive Outfits</p>
              <a href="/secondpage?category=Kids" class="btn btn-outline-light btn-sm align-self-start rounded-0 px-3">Shop Kids →</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Products / New Arrivals Section -->
  <% if (locals.featuredProducts && featuredProducts.length > 0) { %>
    <section class="py-5 bg-white border-top border-bottom">
      <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4">
          <div>
            <span class="text-uppercase tracking-widest text-muted small fw-bold">Handpicked Selection</span>
            <h2 class="display-6 fw-bold mt-1 mb-0">New Arrivals</h2>
          </div>
          <a href="/secondpage" class="btn btn-outline-dark rounded-0 px-4">View All Products →</a>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
          <% featuredProducts.forEach(product => { %>
            <div class="col">
              <div class="card product-hover-card h-100">
                <div class="product-img-wrapper">
                  <% if (product.images && product.images.length > 0) { %>
                    <img src="<%= product.images[0].startsWith('http') ? product.images[0] : '/uploads/' + product.images[0] %>" alt="<%= product.title %>">
                  <% } else { %>
                    <img src="/images/placeholder.jpg" alt="No image">
                  <% } %>
                  <span class="badge bg-dark position-absolute top-0 start-0 m-3 px-2 py-1">New</span>
                </div>
                <div class="card-body d-flex flex-column justify-content-between p-3">
                  <div>
                    <h6 class="card-title fw-bold text-dark text-truncate mb-1"><%= product.title %></h6>
                    <p class="small text-muted mb-2"><%= (product.subcategories && product.subcategories.length > 0) ? product.subcategories.join(', ') : 'Fashion' %></p>
                  </div>
                  <div class="d-flex justify-content-between align-items-center mt-2">
                    <span class="fw-bold fs-5 text-dark">PKR <%= (product.price || 0).toLocaleString() %></span>
                    <a href="/product/<%= product._id %>" class="btn btn-sm btn-dark rounded-0 px-3">View Details</a>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </section>
  <% } %>

  <!-- Flagship Showroom Story & Contact Banner -->
  <section class="py-5">
    <div class="container">
      <div class="showroom-banner text-center position-relative shadow-lg">
        <span class="text-uppercase tracking-widest text-white-50 small fw-semibold d-inline-block mb-2" style="letter-spacing: 3.5px; font-size: 0.78rem;">Heritage &amp; Craftsmanship</span>
        <h2 class="display-5 fw-bold mb-3 text-white" style="letter-spacing: 2px;">AL REHAN SHOPPING CENTER</h2>
        <p class="lead text-white-50 mx-auto mb-4" style="max-width: 720px; font-size: 1.05rem; line-height: 1.7;">
          Welcome to Al Rehan Shopping Center — your premier fashion destination for 100% authentic unstitched lawn, luxury stitched suits, and kids festive collections. Visit our flagship showroom in DG Khan or order online with complete confidence.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
          <a href="/secondpage" class="showroom-btn-primary">Browse All Products</a>
          <a href="https://wa.me/923457139939?text=Hi%2C%20I%20want%20to%20inquire%20about%20your%20latest%20collection" target="_blank" class="showroom-btn-secondary">
            <i class="fab fa-whatsapp me-2"></i>Inquire on WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</main>